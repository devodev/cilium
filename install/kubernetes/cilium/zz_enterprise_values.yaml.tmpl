envoyConfig:
  policy:
    # @schema
    # oneOf:
    # - type: [null]
    # - enum: [global,dedicated]
    # @schema
    # -- Enable a dedicated policy enforcement for each CiliumEnvoyConfig instead of using the ClusterwideCiliumNetworkPolicy.
    mode: "global"
    # -- Interval in which the related policy will be regenerated.
    # Applies to the dedicated mode only
    regenerationInterval: 30s

envoy:
  kubectl:
    image:
      # @schema
      # type: [null, string]
      # @schema
      override: ~
      repository: quay.io/isovalent/kubectl
      tag: 1.0.2
      digest: ""
      useDigest: false
      pullPolicy: "Always"
  # -- Configure Cilium Envoy graceful shutdown.
  gracefulRestart:
    # -- Enables graceful shutdown and draining of traffic for Envoy pods in a standalone DaemonSet.
    # During rolling update 2 pods of Cilium Envoy will exist per node (new and old). All new connections will go to the new pod
    # and traffic will be gracefully drained on the old pod. Proxy will send “Connection: close” for HTTP1 requests
    # or HTTP2 GOAWAY for HTTP2 requests and terminate connections on request completion. When enabling `gracefulRestart` for
    # cilium-envoy daemonset make sure to configure `envoy.terminationGracePeriodSeconds` to a sufficiently large value to allow
    # traffic to drain (e.g. 60 seconds).
    enabled: false
enableNonDefaultDenyPolicies: false
