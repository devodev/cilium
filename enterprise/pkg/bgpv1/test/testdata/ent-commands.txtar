-- cilium-node.yaml --
apiVersion: cilium.io/v2
kind: CiliumNode
metadata:
  name: test-node
spec:
  ipam:
    podCIDRs:
    - 10.244.0.0/24
    - fd00:10:244::/64

-- bgp-node-config.yaml --
apiVersion: isovalent.com/v1
kind: IsovalentBGPNodeConfig
metadata:
  name: test-node
spec:
  bgpInstances:
  - name: instance0
    localASN: 65000
    routerID: 10.99.7.5
    peers:
    - name: peer0
      peerASN: 65000
      peerAddress: fc00:10:99:8::1
      localAddress: fc00:10:99:8::5
      peerConfigRef:
        name: test-peer-config
    - name: peer1
      peerASN: 65000
      peerAddress: fc00:10:99:8::2
      localAddress: fc00:10:99:8::5
      peerConfigRef:
        name: test-peer-config
  - name: instance1
    localASN: 65001
    routerID: 10.99.7.6
    peers:
    - name: peer0
      peerASN: 65001
      peerAddress: fc00:10:99:8::3
      localAddress: fc00:10:99:8::6
      peerConfigRef:
        name: test-peer-config
    - name: peer1
      peerASN: 65001
      peerAddress: fc00:10:99:8::4
      localAddress: fc00:10:99:8::6
      peerConfigRef:
        name: test-peer-config

-- bgp-peer-config.yaml --
apiVersion: isovalent.com/v1
kind: IsovalentBGPPeerConfig
metadata:
  name: test-peer-config
spec:
  transport:
    peerPort: 1790
  timers:
    connectRetryTimeSeconds: 1
  families:
  - afi: ipv4
    safi: unicast
    advertisements:
      matchLabels:
        advertise: bgp
    importPolicyRef:
      name: policy0
  - afi: ipv6
    safi: unicast
    advertisements:
      matchLabels:
        advertise: bgp
    importPolicyRef:
      name: policy0

-- bgp-advertisement.yaml --
apiVersion: isovalent.com/v1
kind: IsovalentBGPAdvertisement
metadata:
  name: test-advertisement
  labels:
    advertise: bgp
spec:
  advertisements:
  - advertisementType: PodCIDR
    attributes:
      asPathPrepend:
        repeat: 2

-- bgp-policy.yaml --
apiVersion: isovalent.com/v1
kind: IsovalentBGPPolicy
metadata:
  name: policy0
spec:
  import:
    statements:
    - conditions:
        prefixesV4:
          matchType: Or
          matches:
          - prefix: 10.0.0.0/16
            minLen: 16
            maxLen: 32
        prefixesV6:
          matchType: Or
          matches:
          - prefix: fd00:10::/32
            minLen: 32
            maxLen: 128
      actions:
        routeAction: Accept

