#! --test-peering-ips=11.99.103.1,11.99.103.2,11.99.103.3,fc00:10:99:103::1,fc00:10:99:103::2 --enable-evpn-security-group-tags --evpn-default-security-group-id=15

# Tests EVPN advertisement of Private Network IPs.
# There are 2 IPv4 GoBGP peers (from which only one is enabled for EVPN advertisements in the peer config) and one IPv6 GoBGP peer.

# Start the hive
hive start

# Configure gobgp servers
gobgp/add-server evpn-v4  65001 11.99.103.2       1790
gobgp/add-server non-evpn 65001 11.99.103.3       1790
gobgp/add-server evpn-v6  65001 fc00:10:99:103::2 1790 --router-id 1.0.0.2

# Configure peers on GoBGP
gobgp/add-peer -s evpn-v4   11.99.103.1       65001 --families=l2vpn/evpn
gobgp/add-peer -s non-evpn  11.99.103.1       65001 --families=l2vpn/evpn
gobgp/add-peer -s evpn-v6   fc00:10:99:103::1 65001 --families=l2vpn/evpn

# Configure BGP on Cilium
k8s/add cilium-node.yaml bgp-node-config.yaml bgp-peer-config-evpn.yaml bgp-peer-config-non-evpn.yaml bgp-vrf-config.yaml bgp-advertisement.yaml

# Wait for peerings to be established
gobgp/wait-state -s evpn-v4  11.99.103.1       ESTABLISHED
gobgp/wait-state -s non-evpn 11.99.103.1       ESTABLISHED
gobgp/wait-state -s evpn-v6  fc00:10:99:103::1 ESTABLISHED

# Add vxlan device to statedb
db/insert devices vxlan-device.yaml

# Add private networks
db/insert private-networks private-networks.yaml

# Validate that no EVPN routes are advertised yet
gobgp/routes -s evpn-v4 -o routes.actual l2vpn evpn
* cmp gobgp-routes-empty.expected routes.actual

# Add privnet workload in network-a
db/insert privnet-local-workloads privnet-workload-a.yaml

# Validate that network-a privnet IPs are not advertised until the endpoint security group is known
gobgp/routes -s evpn-v4 -o routes.actual l2vpn evpn
* cmp gobgp-routes-empty.expected routes.actual

# Add endpoint security group mapping for network-a workload
db/insert evpn-endpoint-security-groups endpoint-security-group-a.v1.yaml

# Validate that network-a privnet IPs are advertised with the endpoint security group ID
gobgp/routes -s evpn-v4 -o routes.actual l2vpn evpn
* cmp gobgp-routes-a-ipv4.v1.expected routes.actual

# Modify endpoint security group mapping for network-a workload
db/insert evpn-endpoint-security-groups endpoint-security-group-a.v2.yaml

# Validate that network-a privnet IPs are re-advertised with the updated endpoint security group ID
gobgp/routes -s evpn-v4 -o routes.actual l2vpn evpn
* cmp gobgp-routes-a-ipv4.v2.expected routes.actual

# Validate that no EVPN routes are advertised to the peer without l2vpn/evpn AFI/SAFI configured in the peer config
gobgp/routes -s non-evpn -o routes.actual l2vpn evpn
* cmp gobgp-routes-empty.expected routes.actual

# Add privnet workload in network-b
db/insert privnet-local-workloads privnet-workload-b.yaml

# Add endpoint security group mapping for network-b workload
db/insert evpn-endpoint-security-groups endpoint-security-group-b.yaml

# Validate that all privnet IPs are being advertised as EVPN routes to the IPv4 peer
gobgp/routes -s evpn-v4 -o routes.actual l2vpn evpn
* cmp gobgp-routes-all-ipv4.expected routes.actual

# Validate that all privnet IPs are being advertised as EVPN routes to the IPv6 peer
gobgp/routes -s evpn-v6 -o routes.actual l2vpn evpn
* cmp gobgp-routes-all-ipv6.expected routes.actual

# Delete privnet workload in network-a
db/delete privnet-local-workloads privnet-workload-a.yaml

# Validate that only network-b privnet IPs are being advertised as EVPN routes
gobgp/routes -s evpn-v4 -o routes.actual l2vpn evpn
* cmp gobgp-routes-b-ipv4.expected routes.actual

# Modify vxlan device MAC
db/insert devices vxlan-device-modified.yaml

# Validate that network-b privnet IPs are being advertised as EVPN routes with modified router's MAC
gobgp/routes -s evpn-v4 -o routes.actual l2vpn evpn
* cmp gobgp-routes-b-modified-mac.expected routes.actual

# Modify VNI for the network-b
db/insert private-networks private-network-b-modified.yaml

# Validate that network-b privnet IPs are being advertised as EVPN routes with modified VNI
gobgp/routes -s evpn-v4 -o routes.actual l2vpn evpn
* cmp gobgp-routes-b-modified-vni.expected routes.actual

# Modify network-b - disable EVPN gateway routes for both IPv4 and IPv6
db/insert private-networks private-network-b-evpn-disabled.yaml

# Validate that no EVPN routes are advertised for network-b when evpngateway=false
gobgp/routes -s evpn-v4 -o routes.actual l2vpn evpn
* cmp gobgp-routes-empty.expected routes.actual

# Modify network-b - enable EVPN gateway route only for IPv4
db/insert private-networks private-network-b-evpn-v4-only.yaml

# Validate that only IPv4 network-b route is advertised to the IPv4 peer
gobgp/routes -s evpn-v4 -o routes.actual l2vpn evpn
* cmp gobgp-routes-b-v4-only-ipv4-peer.expected routes.actual

# Validate that only IPv4 network-b route is advertised to the IPv6 peer
gobgp/routes -s evpn-v6 -o routes.actual l2vpn evpn
* cmp gobgp-routes-b-v4-only-ipv6-peer.expected routes.actual

# Add network-b workload with IPs outside EVPN-enabled subnet CIDRs
db/insert privnet-local-workloads privnet-workload-b-outside-subnet.yaml

# Validate that out-of-subnet endpoint is not advertised to the IPv4 peer
gobgp/routes -s evpn-v4 -o routes.actual l2vpn evpn
* cmp gobgp-routes-b-v4-only-ipv4-peer.expected routes.actual

# Validate that out-of-subnet endpoint is not advertised to the IPv6 peer
gobgp/routes -s evpn-v6 -o routes.actual l2vpn evpn
* cmp gobgp-routes-b-v4-only-ipv6-peer.expected routes.actual

#####

-- cilium-node.yaml --
apiVersion: cilium.io/v2
kind: CiliumNode
metadata:
  name: test-node
spec:
  addresses:
  - ip: 11.99.103.1
    type: InternalIP
  ipam:
    podCIDRs:
    - 10.244.1.0/24
    - fd00:10:244:1::/64

-- bgp-node-config.yaml --
apiVersion: isovalent.com/v1
kind: IsovalentBGPNodeConfig
metadata:
  name: test-node
spec:
  bgpInstances:
  - localASN: 65001
    name: tor-65001
    peers:
    - name: evpn-peer-v4
      peerASN: 65001
      peerAddress: 11.99.103.2
      localAddress: 11.99.103.1
      peerConfigRef:
        name: evpn-peer-config
    - name: non-evpn-peer
      peerASN: 65001
      peerAddress: 11.99.103.3
      localAddress: 11.99.103.1
      peerConfigRef:
        name: non-evpn-peer-config
    - name: evpn-peer-v6
      peerASN: 65001
      peerAddress: fc00:10:99:103::2
      localAddress: fc00:10:99:103::1
      peerConfigRef:
        name: evpn-peer-config
    vrfs:
    - privateNetworkRef:
        name: network-a
      configRef: evpn-config
    - privateNetworkRef:
        name: network-b
      configRef: evpn-config

-- bgp-peer-config-evpn.yaml --
apiVersion: isovalent.com/v1
kind: IsovalentBGPPeerConfig
metadata:
  name: evpn-peer-config
spec:
  transport:
    peerPort: 1790
  timers:
    connectRetryTimeSeconds: 1
  families:
  - afi: l2vpn
    safi: evpn

-- bgp-peer-config-non-evpn.yaml --
apiVersion: isovalent.com/v1
kind: IsovalentBGPPeerConfig
metadata:
  name: non-evpn-peer-config
spec:
  transport:
    peerPort: 1790
  timers:
    connectRetryTimeSeconds: 1
  families:
  - afi: ipv4
    safi: unicast

-- bgp-vrf-config.yaml --
apiVersion: isovalent.com/v1alpha1
kind: IsovalentBGPVRFConfig
metadata:
  name: evpn-config
spec:
  families:
    - afi: ipv6
      safi: unicast
      advertisements:
        matchLabels:
          advertise-to-evpn: "true"
    - afi: ipv4
      safi: unicast
      advertisements:
        matchLabels:
          advertise-to-evpn: "true"

-- bgp-advertisement.yaml --
apiVersion: isovalent.com/v1
kind: IsovalentBGPAdvertisement
metadata:
  name: private-networks
  labels:
    advertise-to-evpn: "true"
spec:
  advertisements:
    - advertisementType: PrivateNetwork
      attributes:
        communities:
          standard:
            - "65001:111"
          large:
            - "65001:111:222"
        localPreference: 200

-- vxlan-device.yaml --
index: 1
name: cilium_evpn
hardwareaddr: [0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff]
type: vxlan
selected: true

-- vxlan-device-modified.yaml --
index: 1
name: cilium_evpn
hardwareaddr: [0x11, 0x22, 0x33, 0x44, 0x55, 0x66]
type: vxlan
selected: true

-- private-networks.yaml --
name: network-a
id: 1
vni: 101
subnets:
- name: evpn-a
  cidrv4: 192.168.100.0/24
  cidrv6: fd10:0:100::/64
  routes:
    - destination: 192.168.0.0/16
      evpngateway: true
    - destination: fd10::/48
      evpngateway: true
---
name: network-b
id: 2
vni: 102
subnets:
- name: evpn-b
  cidrv4: 192.168.200.0/24
  cidrv6: fd10:0:200::/64
  routes:
    - destination: 0.0.0.0/0
      evpngateway: true
    - destination: ::/0
      evpngateway: true

-- private-network-b-modified.yaml --
name: network-b
id: 2
vni: 202
subnets:
- name: evpn-b
  cidrv4: 192.168.200.0/24
  cidrv6: fd10:0:200::/64
  routes:
    - destination: 0.0.0.0/0
      evpngateway: true
    - destination: ::/0
      evpngateway: true

-- private-network-b-evpn-disabled.yaml --
name: network-b
id: 2
vni: 202
subnets:
- name: evpn-b
  cidrv4: 192.168.200.0/24
  cidrv6: fd10:0:200::/64
  routes:
    - destination: 0.0.0.0/0
      gateway: 192.168.200.1
      evpngateway: false
    - destination: ::/0
      gateway: fd10:0:200::1
      evpngateway: false

-- private-network-b-evpn-v4-only.yaml --
name: network-b
id: 2
vni: 202
subnets:
- name: evpn-b
  cidrv4: 192.168.200.0/24
  cidrv6: fd10:0:200::/64
  routes:
    - destination: 0.0.0.0/0
      evpngateway: true
    - destination: ::/0
      gateway: fd10:0:200::1
      evpngateway: false

-- privnet-workload-a.yaml --
endpointid: 1
namespace: default
endpoint:
  name: network-a-pod
  addressing:
    ipv4: 10.244.1.194
    ipv6: fd00:0:0:1::f547
interface:
  network: network-a
  addressing:
    ipv4: 192.168.100.33
    ipv6: fd10:0:100::33

-- privnet-workload-b.yaml --
endpointid: 2
namespace: default
endpoint:
  name: network-b-pod
  addressing:
    ipv4: 10.244.1.201
    ipv6: fd00:0:0:1::9477
interface:
  network: network-b
  addressing:
    ipv4: 192.168.200.33
    ipv6: fd10:0:200::33

-- privnet-workload-b-outside-subnet.yaml --
endpointid: 3
namespace: default
endpoint:
  name: network-b-outside-pod
  addressing:
    ipv4: 10.244.1.202
    ipv6: fd00:0:0:1::9478
interface:
  network: network-b
  addressing:
    ipv4: 192.168.201.44
    ipv6: fd10:0:201::44

-- endpoint-security-group-a.v1.yaml --
endpointid: 1
securitygroupid: 15

-- endpoint-security-group-a.v2.yaml --
endpointid: 1
securitygroupid: 100

-- endpoint-security-group-b.yaml --
endpointid: 2
securitygroupid: 200

