#! --enable-vrf --probe-tcp-md5

# Tests BGP peering over VRF-bound sockets. The red VRF binds the Cilium listen
# socket (gobgp is the active side), the blue VRF binds the Cilium connect
# socket (gobgp is passive). The blue sessions are additionally authenticated
# with a TCP MD5 signature to exercise SO_BINDTODEVICE together with TCP_MD5SIG,
# while the red sessions stay unauthenticated.
#
# After the initial sessions are up, the VRF table IDs are changed. This makes
# the controller recreate the VRF devices (cvrf-1000 -> cvrf-3000, cvrf-2000 ->
# cvrf-4000) and the BGP instances must rebind their sockets to the new devices,
# re-establishing every session for both the listen-bound (red) and the
# connect-bound (blue) instance.

# Start the hive
hive start

# Apply resources
k8s/add vrf-red.yaml vrf-blue.yaml cilium-node.yaml bgp-node-config0.yaml active-peer-config.yaml passive-peer-config.yaml bgp-advertisement0.yaml auth-secret.yaml bgp-policy.yaml

# Assign IP to the red VRF
* addr/add 10.0.0.1/32 cvrf-1000
addr/add fd00::1/128 cvrf-1000

# Assign IP to the blue VRF
* addr/add 10.0.0.1/32 cvrf-2000
addr/add fd00::1/128 cvrf-2000

# Create GoBGP servers and peers. The blue peers are authenticated with a TCP
# MD5 password.
gobgp/add-server red-v4  red-v4-1000.toml
gobgp/add-server red-v6  red-v6-1000.toml
gobgp/add-server blue-v4 blue-v4-2000.toml
gobgp/add-server blue-v6 blue-v6-2000.toml

# Wait for peerings to be established
gobgp/wait-state -s red-v4  10.0.0.1 ESTABLISHED
gobgp/wait-state -s red-v6  fd00::1  ESTABLISHED
gobgp/wait-state -s blue-v4 10.0.0.1 ESTABLISHED
gobgp/wait-state -s blue-v6 fd00::1  ESTABLISHED

# The PodCIDRs are advertised over each VRF-bound session (retry until received).
gobgp/routes -s red-v4  ipv4 unicast -o routes.actual
* cmp routes-v4.expected routes.actual
gobgp/routes -s red-v6  ipv6 unicast -o routes.actual
* cmp routes-v6.expected routes.actual
gobgp/routes -s blue-v4 ipv4 unicast -o routes.actual
* cmp routes-v4.expected routes.actual
gobgp/routes -s blue-v6 ipv6 unicast -o routes.actual
* cmp routes-v6.expected routes.actual

# Advertise routes from the gobgp servers to the Cilium BGP instances. The
# prefixes are completely overlapping. Since VRF is isolated at the BGP and
# kernel level, they should run without interfering with each other.
gobgp/add-route -s red-v4 192.168.0.0/24
gobgp/add-route -s blue-v4 192.168.0.0/24
gobgp/add-route -s red-v6 2001:db8:192:168::/64
gobgp/add-route -s blue-v6 2001:db8:192:168::/64

# The advertised routes are imported to the RIB with the correct table ID
#
# Note that the IPv6 routes are actually not imported to the Linux FIB as
# Linux's IPv6 implementation does not allow self-nexthop (IPv4 does). This is
# not the best, but we accept it as we can at least verify that the routes are
# imported from BGP Update to the RIB.
db/cmp desired-routes desired-routes0.expected

# Change the VRF table IDs. The controller recreates the devices
# (cvrf-1000 -> cvrf-3000, cvrf-2000 -> cvrf-4000) and the BGP instances rebind
# their sockets to the new devices.
k8s/update vrf-red-table3000.yaml vrf-blue-table4000.yaml

# Re-assign the addresses to the recreated devices (retry until they appear).
* addr/add 10.0.0.1/32 cvrf-3000
addr/add fd00::1/128 cvrf-3000
* addr/add 10.0.0.1/32 cvrf-4000
addr/add fd00::1/128 cvrf-4000

# The old gobgp servers were bound to the now-deleted devices. Recreate them on
# the new devices.
gobgp/delete-server red-v4
gobgp/delete-server red-v6
gobgp/delete-server blue-v4
gobgp/delete-server blue-v6
gobgp/add-server red-v4  red-v4-3000.toml
gobgp/add-server red-v6  red-v6-3000.toml
gobgp/add-server blue-v4 blue-v4-4000.toml
gobgp/add-server blue-v6 blue-v6-4000.toml

# Every session re-establishes over the new devices, proving the rebind of both
# the listen-bound (red) and the connect-bound (blue) instance.
gobgp/wait-state -s red-v4  10.0.0.1 ESTABLISHED
gobgp/wait-state -s red-v6  fd00::1  ESTABLISHED
gobgp/wait-state -s blue-v4 10.0.0.1 ESTABLISHED
gobgp/wait-state -s blue-v6 fd00::1  ESTABLISHED

# The PodCIDRs are re-advertised over the rebound sessions (retry until received).
gobgp/routes -s red-v4  ipv4 unicast -o routes.actual
* cmp routes-v4.expected routes.actual
gobgp/routes -s red-v6  ipv6 unicast -o routes.actual
* cmp routes-v6.expected routes.actual
gobgp/routes -s blue-v4 ipv4 unicast -o routes.actual
* cmp routes-v4.expected routes.actual
gobgp/routes -s blue-v6 ipv6 unicast -o routes.actual
* cmp routes-v6.expected routes.actual

# Advertise the same routes again
gobgp/add-route -s red-v4 192.168.0.0/24
gobgp/add-route -s blue-v4 192.168.0.0/24
gobgp/add-route -s red-v6 2001:db8:192:168::/64
gobgp/add-route -s blue-v6 2001:db8:192:168::/64

# The advertised routes are imported again to the RIB with the correct table ID
db/cmp desired-routes desired-routes1.expected

#####

-- red-v4-1000.toml --
[global.config]
  as = 65002
  router-id = "10.0.0.2"
  local-address-list = ["10.0.0.1"]
  port = 1179
  bind-to-device = "cvrf-1000"

[[neighbors]]
  [neighbors.config]
    neighbor-address = "10.0.0.1"
    peer-as = 65001
  [neighbors.transport.config]
    bind-interface = "cvrf-1000"
  [neighbors.timers.config]
    connect-retry = 1
  [[neighbors.afi-safis]]
    [neighbors.afi-safis.config]
      afi-safi-name = "ipv4-unicast"
  [[neighbors.afi-safis]]
    [neighbors.afi-safis.config]
      afi-safi-name = "ipv6-unicast"

-- red-v6-1000.toml --
[global.config]
  as = 65002
  router-id = "10.0.0.2"
  local-address-list = ["fd00::1"]
  port = 1179
  bind-to-device = "cvrf-1000"

[[neighbors]]
  [neighbors.config]
    neighbor-address = "fd00::1"
    peer-as = 65001
  [neighbors.transport.config]
    bind-interface = "cvrf-1000"
  [neighbors.timers.config]
    connect-retry = 1
  [[neighbors.afi-safis]]
    [neighbors.afi-safis.config]
      afi-safi-name = "ipv4-unicast"
  [[neighbors.afi-safis]]
    [neighbors.afi-safis.config]
      afi-safi-name = "ipv6-unicast"

-- blue-v4-2000.toml --
