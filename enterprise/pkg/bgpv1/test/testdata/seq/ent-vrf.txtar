-- vrf-red.yaml --
apiVersion: isovalent.com/v1alpha1
kind: IsovalentCoreVRF
metadata:
  name: red
spec:
  id: 1000
  table: 1000

-- vrf-blue.yaml --
apiVersion: isovalent.com/v1alpha1
kind: IsovalentCoreVRF
metadata:
  name: blue
spec:
  id: 2000
  table: 2000

-- vrf-red-table3000.yaml --
apiVersion: isovalent.com/v1alpha1
kind: IsovalentCoreVRF
metadata:
  name: red
spec:
  id: 1000
  table: 3000

-- vrf-blue-table4000.yaml --
apiVersion: isovalent.com/v1alpha1
kind: IsovalentCoreVRF
metadata:
  name: blue
spec:
  id: 2000
  table: 4000

-- cilium-node.yaml --
apiVersion: cilium.io/v2
kind: CiliumNode
metadata:
  name: test-node
spec:
  addresses:
  - ip: 192.168.0.1
    type: InternalIP
  ipam:
    podCIDRs:
    - 10.244.0.0/24
    - fd00:244::/64

-- bgp-node-config0.yaml --
apiVersion: isovalent.com/v1
kind: IsovalentBGPNodeConfig
metadata:
  name: test-node
spec:
  bgpInstances:

  # Bind to the red VRF. Set localPort to ensure VRF binding to the listen
  # socket works correctly.
  - name: vrf-red
    vrfRef:
      name: red
    localASN: 65001
    localPort: 179
    routerID: 10.0.0.1
    peers:
    - name: red-v4
      peerASN: 65002
      peerAddress: 10.0.0.1
      localAddress: 10.0.0.1
      peerConfigRef:
        name: active-peer-config
    - name: red-v6
      peerASN: 65002
      peerAddress: fd00::1
      localAddress: fd00::1
      peerConfigRef:
        name: active-peer-config

  # Bind to the blue VRF. Don't set localPort and connect to the passive peer to
  # ensure VRF binding to the connect socket works correctly.
  - name: vrf-blue
    vrfRef:
      name: blue
    localASN: 65001
    routerID: 10.0.0.1
    peers:
    - name: blue-v4
      peerASN: 65002
      peerAddress: 10.0.0.1
      localAddress: 10.0.0.1
      peerConfigRef:
        name: passive-peer-config
    - name: blue-v6
      peerASN: 65002
      peerAddress: fd00::1
      localAddress: fd00::1
      peerConfigRef:
        name: passive-peer-config

-- active-peer-config.yaml --
apiVersion: isovalent.com/v1
kind: IsovalentBGPPeerConfig
metadata:
  name: active-peer-config
spec:
  transport:
    # Peer is NOT listening on this port
    peerPort: 22222
  timers:
    connectRetryTimeSeconds: 1
  families:
  - afi: ipv4
    safi: unicast
    importPolicyRef:
      name: policy0
    advertisements:
      matchLabels:
        advertise: bgp
  - afi: ipv6
    safi: unicast
    importPolicyRef:
      name: policy0
    advertisements:
      matchLabels:
        advertise: bgp

-- passive-peer-config.yaml --
apiVersion: isovalent.com/v1
kind: IsovalentBGPPeerConfig
metadata:
  name: passive-peer-config
spec:
  transport:
    peerPort: 1179
  authSecretRef: bgp-auth-secret
  timers:
    connectRetryTimeSeconds: 1
  families:
  - afi: ipv4
    safi: unicast
    importPolicyRef:
      name: policy0
    advertisements:
      matchLabels:
        advertise: bgp
  - afi: ipv6
    safi: unicast
    importPolicyRef:
      name: policy0
    advertisements:
      matchLabels:
        advertise: bgp

-- bgp-policy.yaml --
apiVersion: isovalent.com/v1
kind: IsovalentBGPPolicy
metadata:
  name: policy0
spec:
  import:
    statements:
    - conditions:
        prefixesV4:
          matchType: Or
          matches:
          - prefix: 192.168.0.0/24
        prefixesV6:
          matchType: Or
          matches:
          - prefix: 2001:db8:192:168::/64
      actions:
        routeAction: Accept

-- bgp-advertisement0.yaml --
apiVersion: isovalent.com/v1
kind: IsovalentBGPAdvertisement
metadata:
  labels:
    advertise: bgp
  name: advertisement0
spec:
  advertisements:
  - advertisementType: PodCIDR

-- auth-secret.yaml --
apiVersion: v1
kind: Secret
type: string
metadata:
  name: bgp-auth-secret
  namespace: kube-system
data:
  password: Q2lsaXVtMTIz

-- routes-v4.expected --
Prefix          NextHop    Attrs
10.244.0.0/24   10.0.0.1   [{Origin: i} {AsPath: 65001}]
-- routes-v6.expected --
Prefix          NextHop   Attrs
fd00:244::/64   fd00::1   [{Origin: i} {AsPath: 65001}]
-- desired-routes0.expected --
Owner         Table  Prefix                 Selected  Nexthop
bgp-vrf-blue  2000   192.168.0.0/24         true      10.0.0.1
bgp-vrf-blue  2000   2001:db8:192:168::/64  true      fd00::1
bgp-vrf-red   1000   192.168.0.0/24         true      10.0.0.1
bgp-vrf-red   1000   2001:db8:192:168::/64  true      fd00::1
-- desired-routes1.expected --
Owner         Table  Prefix                 Selected  Nexthop
bgp-vrf-blue  4000   192.168.0.0/24         true      10.0.0.1
bgp-vrf-blue  4000   2001:db8:192:168::/64  true      fd00::1
bgp-vrf-red   3000   192.168.0.0/24         true      10.0.0.1
bgp-vrf-red   3000   2001:db8:192:168::/64  true      fd00::1
