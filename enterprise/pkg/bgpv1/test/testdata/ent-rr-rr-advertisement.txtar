10.244.2.0/24   10.99.102.2         [{Origin: i} {AsPath: } {LocalPref: 100}]
10.244.3.0/24   fc00:10:99:102::2   [{Origin: i} {AsPath: } {LocalPref: 100}]
10.244.4.0/24   10.99.102.3         [{Origin: i} {AsPath: } {LocalPref: 100}]
10.244.5.0/24   fc00:10:99:102::3   [{Origin: i} {AsPath: } {LocalPref: 100}]
10.244.6.0/24   fc00:10:99:102::2   [{Origin: i} {AsPath: } {LocalPref: 100}]
10.244.6.0/24   10.99.102.2         [{Origin: i} {AsPath: } {LocalPref: 100}]
