10.244.1.0/24   10.99.102.1   [{Origin: i} {AsPath: } {LocalPref: 100} {Originator: 1.0.0.1} {ClusterList: [255.0.0.1]}]
10.244.2.0/24   0.0.0.0       [{Origin: i}]
10.244.6.0/24   0.0.0.0       [{Origin: i}]
-- client-v6-routes.expected --
Prefix          NextHop             Attrs
10.244.1.0/24   fc00:10:99:102::1   [{Origin: i} {AsPath: } {LocalPref: 100} {Originator: 1.0.0.1} {ClusterList: [255.0.0.1]}]
10.244.3.0/24   0.0.0.0             [{Origin: i}]
10.244.6.0/24   0.0.0.0             [{Origin: i}]
-- rr-v4-routes.expected --
Prefix          NextHop       Attrs
10.244.1.0/24   10.99.102.1   [{Origin: i} {AsPath: } {LocalPref: 100} {Originator: 1.0.0.1} {ClusterList: [255.0.0.1]}]
10.244.4.0/24   0.0.0.0       [{Origin: i}]
-- rr-v6-routes.expected --
Prefix          NextHop             Attrs
10.244.1.0/24   fc00:10:99:102::1   [{Origin: i} {AsPath: } {LocalPref: 100} {Originator: 1.0.0.1} {ClusterList: [255.0.0.1]}]
10.244.5.0/24   0.0.0.0             [{Origin: i}]
-- external-v4-routes.expected --
Prefix          NextHop             Attrs
10.244.1.0/24   10.99.102.1         [{Origin: i} {AsPath: 65010}]
10.244.2.0/24   10.99.102.2         [{Origin: i} {AsPath: 65010}]
10.244.3.0/24   fc00:10:99:102::2   [{Origin: i} {AsPath: 65010}]
10.244.4.0/24   10.99.102.3         [{Origin: i} {AsPath: 65010}]
10.244.5.0/24   fc00:10:99:102::3   [{Origin: i} {AsPath: 65010}]
10.244.6.0/24   fc00:10:99:102::2   [{Origin: i} {AsPath: 65010}]
10.244.6.0/24   10.99.102.2         [{Origin: i} {AsPath: 65010}]
-- external-v6-routes.expected --
Prefix          NextHop             Attrs
10.244.1.0/24   fc00:10:99:102::1   [{Origin: i} {AsPath: 65010}]
10.244.2.0/24   10.99.102.2         [{Origin: i} {AsPath: 65010}]
10.244.3.0/24   fc00:10:99:102::2   [{Origin: i} {AsPath: 65010}]
10.244.4.0/24   10.99.102.3         [{Origin: i} {AsPath: 65010}]
10.244.5.0/24   fc00:10:99:102::3   [{Origin: i} {AsPath: 65010}]
10.244.6.0/24   fc00:10:99:102::2   [{Origin: i} {AsPath: 65010}]
10.244.6.0/24   10.99.102.2         [{Origin: i} {AsPath: 65010}]
