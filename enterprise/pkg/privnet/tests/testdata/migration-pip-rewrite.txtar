#! --private-networks-enabled

hive start
clustermesh/endpoints/sync
clustermesh/nodes/sync
privnet/epm-finish-restoration
db/initialized

# Deploy some endpoints (including one stale migration)
k8s/add icpn-blue.v1.yaml
k8s/add pneps-worker1.v1.yaml
k8s/add pneps-worker2.v1.yaml

# Populate the CT map with some ongoing connections
privnet/ct-maps-registry/map/upsert TCP OUT  10.244.2.200:12345            10.244.1.100:8000           src_sec_id=123
privnet/ct-maps-registry/map/upsert TCP OUT  10.244.2.200:60123            1.1.1.1:80                  src_sec_id=123
privnet/ct-maps-registry/map/upsert TCP IN   10.244.1.100:45678            10.244.2.200:8080           src_sec_id=456
privnet/ct-maps-registry/map/upsert TCP IN   [2606:4700:4700::1001]:49214  [fd00:10:244:2::200]:9000   src_sec_id=10
privnet/ct-maps-registry/map/upsert TCP IN   [fd00:10:244:1::100]:34567    [fd00:10:244:2::200]:9000   src_sec_id=456
privnet/ct-maps-registry/map/upsert UDP OUT  10.244.2.200:34567            10.244.1.100:53             src_sec_id=123
privnet/ct-maps-registry/map/upsert UDP OUT  [fd00:10:244:2::200]:34567    [fd00:10:244:1::100]:53     src_sec_id=123

# Assert CT maps pre-migration
privnet/ct-maps-registry/map/show cilium_ct_any4_global
cmp stdout ctmap-any4.v1.txt

privnet/ct-maps-registry/map/show cilium_ct4_global
cmp stdout ctmap-tcp4.v1.txt

privnet/ct-maps-registry/map/show cilium_ct_any6_global
cmp stdout ctmap-any6.v1.txt

privnet/ct-maps-registry/map/show cilium_ct6_global
cmp stdout ctmap-tcp6.v1.txt

# Migrate optimum-mouse to worker-node-3
k8s/add pneps-worker3.v2.yaml

# Wait for the reconciler to settle
db/show privnet-migration-pip-rewrite -o migration-pip-rewrite.v2.table
sed 'Done \([^)]+\)' 'Done (<time>)' migration-pip-rewrite.v2.table
* cmp migration-pip-rewrite.expected.v2.table migration-pip-rewrite.v2.table

# Assert CT maps post-migration
privnet/ct-maps-registry/map/show cilium_ct_any4_global
cmp stdout ctmap-any4.v2.txt

privnet/ct-maps-registry/map/show cilium_ct4_global
cmp stdout ctmap-tcp4.v2.txt

privnet/ct-maps-registry/map/show cilium_ct_any6_global
cmp stdout ctmap-any6.v2.txt

privnet/ct-maps-registry/map/show cilium_ct6_global
cmp stdout ctmap-tcp6.v2.txt

-- icpn-blue.v1.yaml --
apiVersion: isovalent.com/v1alpha1
kind: ClusterwidePrivateNetwork
metadata:
  name: blue-network
spec:
  subnets:
  - name: blue-0
    cidrv4: 192.168.250.0/24
    cidrv6: fd10:0:250::0/64

-- pneps-worker1.v1.yaml --
apiVersion: isovalent.com/v1alpha1
kind: PrivateNetworkEndpointSlice
metadata:
  namespace: default
  name: worker-node-1
nodeName: worker-node-1
endpoints:
- activatedAt: "2025-06-20T15:54:04.501000Z"
  endpoint:
    addressing:
      ipv4: 10.244.1.100
      ipv6: fd00:10:244:1::100
    name: optimum-mouse
  interface:
    addressing:
      ipv4: 192.168.250.10
      ipv6: fd10:0:250::10
    mac: 00:50:56:ad:45:ec
    network: blue-network
- activatedAt: "2025-06-19T08:00:00.000000Z"
  endpoint:
    addressing:
      ipv4: 10.244.1.101
      ipv6: fd00:10:244:1::101
    previousAddressing:
    - ipv4: 10.244.2.200
      ipv6: fd00:10:244:2::200
      lastSeen: "2025-06-19T08:00:00.000000Z"
    name: stale-snail
  interface:
    addressing:
      ipv4: 192.168.250.11
      ipv6: fd10:0:250::11
    mac: 52:74:7c:37:8a:13
    network: blue-network

-- pneps-worker2.v1.yaml --
apiVersion: isovalent.com/v1alpha1
kind: PrivateNetworkEndpointSlice
metadata:
  namespace: default
  name: worker-node-2
nodeName: worker-node-2
endpoints:
- activatedAt: "2025-06-20T16:29:49.321000Z"
  endpoint:
    addressing:
      ipv4: 10.244.2.200
      ipv6: fd00:10:244:2::200
    name: pumped-ocelot
  interface:
    addressing:
      ipv4: 192.168.250.20
      ipv6: fd10:0:250::20
    mac: 00:50:56:ad:45:d8
    network: blue-network

-- pneps-worker3.v2.yaml --
apiVersion: isovalent.com/v1alpha1
kind: PrivateNetworkEndpointSlice
metadata:
  namespace: default
  name: worker-node-3
nodeName: worker-node-3
endpoints:
- activatedAt: "2025-06-20T16:10:11.131200Z"
  endpoint:
    addressing:
      ipv4: 10.244.3.50
      ipv6: fd00:10:244:3::50
    previousAddressing:
    - ipv4: 10.244.1.100
      ipv6: fd00:10:244:1::100
      lastSeen: "2025-06-20T16:00:00.000000Z"
    name: optimum-mouse
  interface:
    addressing:
      ipv4: 192.168.250.10
      ipv6: fd10:0:250::10
    mac: 00:50:56:ad:45:ec
    network: blue-network

