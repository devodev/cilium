    - destination: 0.0.0.0/0
      gateway: 192.168.24.24

-- icpn-green.v1.yaml --
apiVersion: isovalent.com/v1alpha1
kind: ClusterwidePrivateNetwork
metadata:
  name: green-network
spec:
  networkBridges:
  - cluster: camelidae
  subnets:
  - name: green1
    cidrv4: 10.0.100.0/24
    cidrv6: fd00:10:100::0/64

