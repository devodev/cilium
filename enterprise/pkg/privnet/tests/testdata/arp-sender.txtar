-- arp.v1.table --
Network         NetworkID   Subnet    SubnetID   IPv4
direct-maggot   0x1         subnet1   0x1        192.168.250.10

-- arp.v2.table --
Network         NetworkID   Subnet    SubnetID   IPv4
direct-maggot   0x1         subnet1   0x1        192.168.250.10
direct-maggot   0x1         subnet2   0x2        192.168.251.10

-- arp.v3.table --
Network         NetworkID   Subnet    SubnetID   IPv4
direct-maggot   0x1         subnet1   0x1        192.168.250.20
direct-maggot   0x1         subnet2   0x2        192.168.251.10

-- arp.v4.table --
Network         NetworkID   Subnet    SubnetID   IPv4
direct-maggot   0x1         subnet1   0x1        192.168.250.20

-- arp.v1.map --
0x1/0x1 -> 192.168.250.10
-- arp.v2.map --
0x1/0x1 -> 192.168.250.10
0x1/0x2 -> 192.168.251.10
-- arp.v3.map --
0x1/0x1 -> 192.168.250.20
0x1/0x2 -> 192.168.251.10
-- arp.v4.map --
0x1/0x1 -> 192.168.250.20
