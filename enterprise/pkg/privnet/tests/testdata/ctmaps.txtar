#! --private-networks-enabled

# Create a few map pins to validate pruning.
privnet/ct-maps-registry/create-pin cilium_privnet_00001_ct4_global
privnet/ct-maps-registry/create-pin cilium_privnet_00001_ct6_global
privnet/ct-maps-registry/create-pin cilium_privnet_00001_ct_any4_global
privnet/ct-maps-registry/create-pin cilium_privnet_00001_ct_any6_global
privnet/ct-maps-registry/create-pin cilium_privnet_00009_ct4_global
privnet/ct-maps-registry/create-pin cilium_privnet_00009_ct6_global
privnet/ct-maps-registry/create-pin cilium_privnet_00009_ct_any4_global
privnet/ct-maps-registry/create-pin cilium_privnet_00009_ct_any6_global

# Create a few more that don't match the format, and should not be removed.
privnet/ct-maps-registry/create-pin cilium_privnet_02_ct4_global
privnet/ct-maps-registry/create-pin cilium_privnet_00002_ct6_global_foo
privnet/ct-maps-registry/create-pin foo_cilium_privnet_00002_ct_any4_global
privnet/ct-maps-registry/create-pin cilium_privnet_ct_any6_global

# Add an already existing private network, before starting the hive.
k8s/add icpn-1.yaml

hive start
db/initialized private-networks privnet-ctmaps

# Add one more private networks...
k8s/add icpn-2.yaml

# ... and check that they are reflected into the ctmaps table,
db/cmp privnet-ctmaps ctmaps.v1.table

# ... and that the expected CT maps have been created,
privnet/ct-maps-registry/list
* cmp stdout registry.v1.txt

# ... and that the maps of maps have been populated correctly.
privnet/maps-dump privnet_ct4_global
* cmp stdout ct4_global.v1.txt
privnet/maps-dump privnet_ct6_global
* cmp stdout ct6_global.v1.txt
privnet/maps-dump privnet_ct_any4_global
* cmp stdout ct_any4_global.v1.txt
privnet/maps-dump privnet_ct_any6_global
* cmp stdout ct_any6_global.v1.txt

# Assert that stale map pins have been pruned.
privnet/ct-maps-registry/list-pins
* cmp stdout ct-maps-pins.txt

# Add one more private network...
k8s/add icpn-3.yaml

# ... and check that it gets reflected into the ctmaps table,
db/show privnet-ctmaps ctmaps.v2.table

# ... and that the expected CT maps are created,
privnet/ct-maps-registry/list
* cmp stdout registry.v2.txt

# ... and that the maps of maps are updated correctly.
privnet/maps-dump privnet_ct4_global
* cmp stdout ct4_global.v2.txt
privnet/maps-dump privnet_ct6_global
* cmp stdout ct6_global.v2.txt
privnet/maps-dump privnet_ct_any4_global
* cmp stdout ct_any4_global.v2.txt
privnet/maps-dump privnet_ct_any6_global
* cmp stdout ct_any6_global.v2.txt

# Delete one private network...
k8s/delete icpn-2.yaml

# ... and check that it gets removed from the ctmaps table,
db/cmp privnet-ctmaps ctmaps.v3.table

# ... and that the corresponding CT maps are removed,
privnet/ct-maps-registry/list
* cmp stdout registry.v3.txt

# ... and that the maps of maps are updated correctly.
privnet/maps-dump privnet_ct4_global
* cmp stdout ct4_global.v3.txt
privnet/maps-dump privnet_ct6_global
* cmp stdout ct6_global.v3.txt
privnet/maps-dump privnet_ct_any4_global
* cmp stdout ct_any4_global.v3.txt
privnet/maps-dump privnet_ct_any6_global
* cmp stdout ct_any6_global.v3.txt

# Create it back, but simulate a failure when creating the maps...
privnet/ct-maps-registry/inject-failure cilium_privnet_00004_ct_any4_global
k8s/add icpn-2.yaml

# ... and check that it gets reflected into the ctmaps table,
db/cmp privnet-ctmaps ctmaps.v4.table

# ... and that the error is bubbled up by the reconciler,
db/get privnet-ctmaps 4 -o ctmaps.united-firefly.actual
* grep -q 'hit the bomb' ctmaps.united-firefly.actual

# ... and that the failing maps got closed and unpinned (we need to enable
# retries as we may hit the exact instant in which a map was created, before
# it is deleted again afterwards),
privnet/ct-maps-registry/list
* cmp stdout registry.v3.txt

# ... and that the maps of maps have not been modified.
privnet/maps-dump privnet_ct4_global
cmp stdout ct4_global.v3.txt
privnet/maps-dump privnet_ct6_global
cmp stdout ct6_global.v3.txt
privnet/maps-dump privnet_ct_any4_global
cmp stdout ct_any4_global.v3.txt
privnet/maps-dump privnet_ct_any6_global
cmp stdout ct_any6_global.v3.txt

# Withdraw the simulated failure...
privnet/ct-maps-registry/withdraw-failure cilium_privnet_00004_ct_any4_global

# ... and assert that the corresponding CT maps are created,
privnet/ct-maps-registry/list
* cmp stdout registry.v4.txt

# ... and that the maps of maps are updated correctly.
privnet/maps-dump privnet_ct4_global
* cmp stdout ct4_global.v4.txt
privnet/maps-dump privnet_ct6_global
* cmp stdout ct6_global.v4.txt
privnet/maps-dump privnet_ct_any4_global
* cmp stdout ct_any4_global.v4.txt
privnet/maps-dump privnet_ct_any6_global
* cmp stdout ct_any6_global.v4.txt

# Stop the hive...
hive stop

# ... validate that the maps are closed (but not unpinned),
privnet/ct-maps-registry/list
cmp stdout registry.stopped.txt

# ... and that the maps of maps have not been changed.
privnet/maps-dump privnet_ct4_global
cmp stdout ct4_global.v4.txt
privnet/maps-dump privnet_ct6_global
cmp stdout ct6_global.v4.txt
privnet/maps-dump privnet_ct_any4_global
cmp stdout ct_any4_global.v4.txt
privnet/maps-dump privnet_ct_any6_global
cmp stdout ct_any6_global.v4.txt

# ---

-- icpn-1.yaml --
apiVersion: isovalent.com/v1alpha1
kind: ClusterwidePrivateNetwork
metadata:
  name: direct-maggot
spec:
  subnets:
  - name: default
    cidrv4: 192.168.250.0/24

-- icpn-2.yaml --
apiVersion: isovalent.com/v1alpha1
kind: ClusterwidePrivateNetwork
metadata:
  name: united-firefly
spec:
  subnets:
  - name: default
    cidrv4: 192.168.251.0/24

-- icpn-3.yaml --
apiVersion: isovalent.com/v1alpha1
kind: ClusterwidePrivateNetwork
metadata:
  name: knowing-turtle
spec:
  subnets:
  - name: default
    cidrv4: 192.168.252.0/24


-- ctmaps.v1.table --
Network          NetworkID
direct-maggot    0x1
united-firefly   0x2

-- ctmaps.v2.table --
Network          NetworkID
direct-maggot    0x1
united-firefly   0x2
knowing-turtle   0x3

-- ctmaps.v3.table --
Network          NetworkID
direct-maggot    0x1
knowing-turtle   0x3

-- ctmaps.v4.table --
Network          NetworkID
direct-maggot    0x1
knowing-turtle   0x3
united-firefly   0x4


