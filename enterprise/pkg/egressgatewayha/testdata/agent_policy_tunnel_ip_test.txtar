#! --preferred-tunnel-endpoint-devices=cilium_host

hive start

db/initialized

# Add initial k8s resources.
k8s/add node1.yaml ciliumnode1.yaml
k8s/add policy1.yaml policy2.yaml
k8s/add ciliumendpoint1.yaml ciliumendpoint2.yaml

db/insert devices device-eth0.yaml device-eth1.yaml device-cilium_host.yaml

# break

# Wait and check for in memory state
db/show policy-config --columns ID,Endpoints,Generation,IsGateway,Interface,Ifindex,EgressIP,Groups
db/cmp --timeout=10s policy-config policyconfig.expected.1

db/show egress-ips --columns Address,Interface
db/cmp --timeout=10s egress-ips egressips.expected.1

db/show sysctl --columns Name,Value
db/cmp --timeout=10s sysctl sysctl.expected.1

# Check that manager realizes expected bpf map state.
egressha/policy-maps-dump policymap.actual
* cmp policymap.actual policymap.expected.1

-- policyconfig.expected.1 --
ID        Endpoints       Generation   IsGateway   Interface   Ifindex     EgressIP    Groups
policy1   [10.244.3.91]   1            true        eth0        1           100.1.2.3   [active=[10.254.0.1],healthy=[10.254.0.1],byGateway=map[10.254.0.1:100.1.2.3]]
policy2   [10.244.3.92]   1            true                    0           100.1.2.4   [active=[10.254.0.1],healthy=[10.254.0.1],byGateway=map[10.254.0.1:100.1.2.4]]
-- egressips.expected.1 --
Address   Interface
100.1.2.3 eth0
100.1.2.4
-- sysctl.expected.1 --
Name                               Value
net.ipv4.conf.eth0.rp_filter       2
-- policymap.expected.1 --
source_ip=10.244.3.91 dest_cidr=0.0.0.0 egress_ip=100.1.2.3 egress_ifindex=1 gateway_ips=[10.254.0.1]
source_ip=10.244.3.92 dest_cidr=0.0.0.0 egress_ip=100.1.2.4 egress_ifindex=0 gateway_ips=[10.254.0.1]
-- node1.yaml --
apiVersion: v1
kind: Node
metadata:
  name: localnode1
  uid: c57b0909-b567-48a3-865a-c1d1a17b545d
status:
  addresses:
  - address: 172.18.0.3
    type: InternalIP
  - address: 10.254.0.1
    type: CiliumTunnelIP
-- ciliumnode1.yaml --
apiVersion: cilium.io/v2
kind: CiliumNode
metadata:
  generation: 1
  labels:
    kubernetes.io/hostname: workernode0
    foo: bar
  name: worker0
  uid: 00000000-0000-0000-0000-000000000000
spec:
  addresses:
  - ip: 172.18.0.3
    type: InternalIP
  - ip: 10.254.0.1
    type: CiliumTunnelIP
-- policy1.yaml --
apiVersion: isovalent.com/v1
kind: IsovalentEgressGatewayPolicy
metadata:
  generation: 1
  name: policy1
  uid: 00000000-0000-0000-0000-000000000000
spec:
  azAffinity: disabled
  destinationCIDRs:
  - 0.0.0.0/0
  egressCIDRs:
  - 100.1.2.3/32
  egressGroups:
  - maxGatewayNodes: 0
    interface: eth0
    nodeSelector:
      matchLabels:
        kubernetes.io/hostname: workernode0
  excludedCIDRs: []
  selectors:
  - podSelector:
      matchLabels:
        foo: bar
status:
  groupStatuses:
  - activeGatewayIPs:
    - 10.254.0.1
    healthyGatewayIPs:
    - 10.254.0.1
    egressIPByGatewayIP: {"10.254.0.1": "100.1.2.3"}
  observedGeneration: 1
-- policy2.yaml --
apiVersion: isovalent.com/v1
kind: IsovalentEgressGatewayPolicy
metadata:
  generation: 1
  name: policy2
  uid: 00000000-0000-0000-0000-000000000001
  annotations:
    egw.isovalent.com/virtual-ip: "true"
spec:
  azAffinity: disabled
  destinationCIDRs:
  - 0.0.0.0/0
  egressCIDRs:
  - 100.1.2.4/32
  egressGroups:
  - maxGatewayNodes: 0
    nodeSelector:
      matchLabels:
        kubernetes.io/hostname: workernode0
  excludedCIDRs: []
  selectors:
  - podSelector:
      matchLabels:
        foo: bar2
status:
  groupStatuses:
  - activeGatewayIPs:
    - 10.254.0.1
    healthyGatewayIPs:
    - 10.254.0.1
    egressIPByGatewayIP: {"10.254.0.1": "100.1.2.4"}
  observedGeneration: 1
